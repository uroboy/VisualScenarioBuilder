# ========== Slack設定 ==========
# Slack Bot Token
# Slack API Console から取得: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-token-here

# 通知先チャンネル（デフォルト）
SLACK_CHANNEL=#test-automation

# ========== Androidデバイス設定 ==========
# デバイスシリアル番号（複数の場合はコンマ区切り）
# 空の場合は自動で最初に検出されたデバイスを使用
DEVICE_ID=emulator-5554

# adb ホスト（リモートADB接続の場合）
ADB_HOST=localhost
ADB_PORT=5037

# ========== テスト設定 ==========
# 実行するテストシナリオ
TEST_SCENARIO=test_scenario_example.yaml

# テスト実行タイムアウト（秒）
TEST_TIMEOUT=3600

# スクリーンショット出力ディレクトリ
SCREENSHOT_DIR=./screenshots

# ========== ロギング設定 ==========
# ログレベル: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ログファイルパス
LOG_FILE=./logs/test_framework.log

# ========== 人間入力（Slack）設定 ==========
# 人間入力のデフォルトタイムアウト（秒）
HUMAN_INPUT_TIMEOUT=600

# Slack ポーリング間隔（秒）
SLACK_POLL_INTERVAL=2

# ========== データベース設定（Redis）==========
# Redis接続（セッション/キャッシュ用）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== プロキシ設定 ==========
# HTTPプロキシ（必要に応じて）
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# ========== その他 ==========
# タイムゾーン
TZ=Asia/Tokyo

# デバッグモード
DEBUG=false

# 結果ディレクトリ
RESULTS_DIR=./results
