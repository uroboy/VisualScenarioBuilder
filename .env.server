# ==================== Visual Scenario Builder - Server Mode ====================

# ===== API 設定 =====
# バックエンドが listen するホスト（0.0.0.0 = 全インターフェース）
API_HOST=0.0.0.0
API_PORT=8000

# フロントエンドから API へアクセスするURL
# ※ サーバIPアドレスやドメイン名に変更してください
REACT_APP_API_URL=http://localhost:8000/api

# ===== ADB 設定 =====
# ローカル接続の場合
ADB_HOST=localhost
ADB_PORT=5037

# リモート adb デバイスの場合（例）
# ADB_HOST=192.168.1.100
# ADB_PORT=5037

# ===== CORS 設定 =====
# カンマ区切りで複数のオリジンを指定可能
# 本番環境では * を使わず、明示的に許可するオリジンを指定してください
ALLOWED_ORIGINS=*

# ===== ロギング =====
LOG_LEVEL=INFO
# 選択肢: DEBUG, INFO, WARNING, ERROR, CRITICAL

# ===== ファイアウォール =====
# ポート 3000, 8000 をファイアウォールで許可してください
# sudo ufw allow 3000/tcp
# sudo ufw allow 8000/tcp
